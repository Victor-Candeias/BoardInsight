<Window x:Class="BoardInsight.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BoardInsight"
        Icon="BoardInsight.ico"
        Width="1440" Height="900" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Surface}">
    <Grid>
        <wv2:WebView2 x:Name="Browser" Visibility="Hidden" DefaultBackgroundColor="#F8FAFC" />

        <Border x:Name="StatusPanel" Background="{StaticResource Surface}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="620">
                <Image Source="logo.png" Width="300" Margin="0,0,0,28" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="StatusTitle" Text="A abrir o BoardInsight…" FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource BrandNavy}" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="StatusDetail" Margin="0,10,0,0" FontSize="14" Foreground="{StaticResource Muted}"
                           TextAlignment="Center" TextWrapping="Wrap" />
                <ProgressBar x:Name="Progress" IsIndeterminate="True" Height="4" Width="260" Margin="0,24,0,0" />
                <StackPanel x:Name="Actions" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0"
                            Visibility="Collapsed">
                    <Button x:Name="RetryButton" Content="Tentar novamente" Style="{StaticResource ActionButton}"
                            Click="Retry_Click" IsDefault="True" />
                    <Button x:Name="InstallRuntimeButton" Content="Obter o WebView2" Style="{StaticResource ActionButton}"
                            Click="InstallRuntime_Click" Visibility="Collapsed" />
                    <Button Content="Abrir no browser" Style="{StaticResource ActionButton}" Click="OpenInBrowser_Click" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
