# BoardInsight (Windows) — modelo do .env criado pelo instalador em %ProgramData%\BoardInsight\.env.
# O instalador preenche BUSINESSMAP_*, APP_PORT, EXPORT_DIR, FRONTEND_DIST e gera MONGODB_PASSWORD.
# Para alterar a API key ou a porta: editar como Administrador e reiniciar os serviços boardinsight-api
# e boardinsight-worker.

APP_ENV=production
# Só nesta máquina (G9): o instalador repõe 127.0.0.1 em cada instalação/atualização.
APP_HOST=127.0.0.1
APP_PORT=8080
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Lisbon
# A API serve o site (mesma origem): não é preciso CORS.
CORS_ORIGINS=
FRONTEND_DIST=

# MongoDB incluído no instalador (serviço boardinsight-mongodb, só 127.0.0.1, porta dedicada).
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27018
MONGODB_DATABASE=BoardInsight
MONGODB_USERNAME=boardinsight
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=BoardInsight

# Autenticação com email e password do domínio (Active Directory por LDAPS; nada é guardado localmente).
# Desligada (G10): sem janela de login; o instalador repõe false em cada instalação/atualização.
AUTH_ENABLED=false
LDAP_DOMAIN=w2k.ctt.pt
# Vazio = DCs descobertos por DNS (_ldap._tcp.dc._msdcs.<domínio>) em ldaps://<dc>:636. Lista separada por vírgulas;
# ldap://host:389 só com StartTLS (obrigatório). O certificado do DC é sempre validado.
LDAP_URL=
# Vazio = derivado do domínio (DC=w2k,DC=ctt,DC=pt).
LDAP_BASE_DN=
# CA da PKI interna (PEM) se não estiver no repositório de certificados do Windows.
LDAP_CA_FILE=
# Conta de serviço (opcional) para encontrar o utilizador pelo email quando o email não é o UPN.
LDAP_BIND_USER=
LDAP_BIND_PASSWORD=
LDAP_TIMEOUT_SECONDS=5
# Grupo AD autorizado (nome ou DN, inclui grupos aninhados); vazio = qualquer utilizador do domínio.
AUTH_ALLOWED_GROUP=
AUTH_SESSION_TTL_MINUTES=480
AUTH_SESSION_MAX_HOURS=24
AUTH_MAX_FAILED_LOGINS=5

# Businessmap (API REST v2, só leitura)
BUSINESSMAP_BASE_URL=https://cttv8.kanbanize.com
BUSINESSMAP_API_KEY=
BUSINESSMAP_BOARD_ID=96
BUSINESSMAP_TIMEOUT_SECONDS=30
BUSINESSMAP_MAX_RETRIES=4
BUSINESSMAP_PAGE_SIZE=200

# Sincronização (tarefa agendada "BoardInsight\Sync" a cada 30 minutos)
SYNC_INTERVAL_MINUTES=30
SYNC_LOCK_TTL_MINUTES=20
STALE_AFTER_MINUTES=90

ATTENTION_WIP_PER_PERSON=3

WORKER_POLL_SECONDS=2
JOB_TIMEOUT_MINUTES=30
JOB_RETENTION_DAYS=7

EXPORT_DIR=
EXPORT_RETENTION_DAYS=30
EXPORT_MAX_ROWS=50000
EXPORT_PDF_MAX_ROWS=2000

RETENTION_HISTORY_DAYS=183
RETENTION_RAW_DAYS=30
RETENTION_SYNC_RUNS_DAYS=90
LOGGED_TIME_SYNC_DAYS=35

RATE_LIMIT_SYNC_PER_MINUTE=2
RATE_LIMIT_EXPORT_PER_MINUTE=6
