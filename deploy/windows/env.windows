# BoardInsight (Windows) — modelo do .env criado pelo instalador em %ProgramData%\BoardInsight\.env.
# O instalador preenche BUSINESSMAP_*, APP_PORT, EXPORT_DIR, FRONTEND_DIST e gera MONGODB_PASSWORD.
# Para alterar a API key ou a porta: editar como Administrador e reiniciar os serviços boardinsight-api
# e boardinsight-worker (a porta também exige atualizar a regra de firewall "BoardInsight").

APP_ENV=production
# 0.0.0.0 = acessível na rede local (a firewall decide); 127.0.0.1 = só nesta máquina.
APP_HOST=0.0.0.0
APP_PORT=8080
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Lisbon
# A API serve o site (mesma origem): não é preciso CORS.
CORS_ORIGINS=
FRONTEND_DIST=

# MongoDB incluído no instalador (serviço boardinsight-mongodb, só 127.0.0.1, porta dedicada).
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27018
MONGODB_DATABASE=BoardInsight
MONGODB_USERNAME=boardinsight
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=BoardInsight

# Businessmap (API REST v2, só leitura)
BUSINESSMAP_BASE_URL=https://cttv8.kanbanize.com
BUSINESSMAP_API_KEY=
BUSINESSMAP_BOARD_ID=96
BUSINESSMAP_TIMEOUT_SECONDS=30
BUSINESSMAP_MAX_RETRIES=4
BUSINESSMAP_PAGE_SIZE=200

# Sincronização (tarefa agendada "BoardInsight\Sync" a cada 30 minutos)
SYNC_INTERVAL_MINUTES=30
SYNC_LOCK_TTL_MINUTES=20
STALE_AFTER_MINUTES=90

ATTENTION_WIP_PER_PERSON=3

WORKER_POLL_SECONDS=2
JOB_TIMEOUT_MINUTES=30
JOB_RETENTION_DAYS=7

EXPORT_DIR=
EXPORT_RETENTION_DAYS=30
EXPORT_MAX_ROWS=50000
EXPORT_PDF_MAX_ROWS=2000

RETENTION_HISTORY_DAYS=183
RETENTION_RAW_DAYS=30
RETENTION_SYNC_RUNS_DAYS=90

RATE_LIMIT_SYNC_PER_MINUTE=2
RATE_LIMIT_EXPORT_PER_MINUTE=6
