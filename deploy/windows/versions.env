# Versões fixadas para o instalador Windows (deploy/windows/build-installer.sh).
# Ao atualizar uma versão, atualizar também o SHA256 (sha256sum do ficheiro descarregado).

# Python embeddable (tem de ser 3.13: requires-python do backend e wheels cp313).
PYTHON_VERSION=3.13.17
PYTHON_URL=https://www.python.org/ftp/python/3.13.17/python-3.13.17-embed-amd64.zip
PYTHON_SHA256=9e35319bffedab8b36ad44d8f377cb4f1733bcec257a0b6d04d94f01486ddb38

# MongoDB Community (só mongod.exe + vc_redist.x64.exe). SHA256 oficial de downloads.mongodb.org.
MONGODB_VERSION=8.0.34
MONGODB_URL=https://fastdl.mongodb.org/windows/mongodb-windows-x86_64-8.0.34.zip
MONGODB_SHA256=6b021a0864494e4decf278b36477a29eb36072432773e4e62c2f42c302630db0

# WinSW 2.x x64 (self-contained, não precisa de .NET instalado).
WINSW_VERSION=2.12.0
WINSW_URL=https://github.com/winsw/winsw/releases/download/v2.12.0/WinSW-x64.exe
WINSW_SHA256=05b82d46ad331cc16bdc00de5c6332c1ef818df8ceefcd49c726553209b3a0da

# Inno Setup (compilador; corre sob Wine).
INNOSETUP_VERSION=6.7.3
INNOSETUP_URL=https://github.com/jrsoftware/issrc/releases/download/is-6_7_3/innosetup-6.7.3.exe
INNOSETUP_SHA256=9c73c3bae7ed48d44112a0f48e66742c00090bdb5bef71d9d3c056c66e97b732

# Wine portátil (sem root). A 11.20 dá segfault neste Debian; a 11.0 estável funciona.
WINE_VERSION=11.0
WINE_URL=https://github.com/Kron4ek/Wine-Builds/releases/download/11.0/wine-11.0-amd64-wow64.tar.xz
WINE_SHA256=39574efa1132c3ca0d5c77dd2eddbe4a49cca0d6cc2c290ff4924493a1c40314
