[Unit]
Description=BoardInsight — API (FastAPI/Uvicorn em 127.0.0.1:8000)
After=network-online.target mongodb44.service
Wants=network-online.target

[Service]
Type=simple
User=boardinsight
Group=boardinsight
WorkingDirectory=/opt/boardinsight/backend
Environment=BOARDINSIGHT_ENV_FILE=/opt/boardinsight/.env
# Um único worker: o servidor tem 1,9 GiB de RAM. Só loopback; a LAN entra pelo Nginx.
ExecStart=/opt/boardinsight/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
MemoryMax=300M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/boardinsight

[Install]
WantedBy=multi-user.target
