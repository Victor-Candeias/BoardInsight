[Unit]
Description=BoardInsight sincronização Businessmap (todos os boards ativos; deploy local em /opt/BoardInsight)
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/BoardInsight/backend
Environment=BOARDINSIGHT_ENV_FILE=/opt/BoardInsight/.env
Environment=PYTHONUNBUFFERED=1
Environment=EXPORT_DIR=/opt/BoardInsight/data/exports
ExecStart=/opt/BoardInsight/backend/.venv/bin/python -m app.jobs.sync
# O lock por board (TTL SYNC_LOCK_TTL_MINUTES) evita sobreposição com o worker.
TimeoutStartSec=25min
Nice=10
