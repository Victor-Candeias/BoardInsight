# BoardInsight — copiar para `.env` (chmod 600). Nunca commitar o `.env` real.

APP_ENV=production
APP_HOST=127.0.0.1
APP_PORT=8000
APP_LOG_LEVEL=INFO
APP_TIMEZONE=Europe/Lisbon
# Origens autorizadas para CORS (separadas por vírgulas, ex.: http://192.168.1.97:5180). Vazio = mesma
# origem apenas (Nginx). '*' não é aceite. Escritas (POST/PUT/DELETE) de outras origens recebem 403.
CORS_ORIGINS=
# Pasta frontend/dist servida pela própria API (instalação Windows, sem Nginx). Vazio = a API não serve o site.
FRONTEND_DIST=

# MongoDB 4.4 — usar MONGODB_URI ou os campos separados abaixo.
# MONGODB_URI=mongodb://utilizador:password@127.0.0.1:27017/?authSource=BoardInsight
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DATABASE=BoardInsight
MONGODB_USERNAME=boardinsight
MONGODB_PASSWORD=COLOCAR_APENAS_NO_ENV_REAL
MONGODB_AUTH_SOURCE=BoardInsight

# Businessmap (API REST v2, só leitura)
BUSINESSMAP_BASE_URL=https://cttv8.kanbanize.com
BUSINESSMAP_API_KEY=COLOCAR_APENAS_NO_ENV_REAL
BUSINESSMAP_BOARD_ID=96
BUSINESSMAP_TIMEOUT_SECONDS=30
BUSINESSMAP_MAX_RETRIES=4
BUSINESSMAP_PAGE_SIZE=200

# Sincronização (timer systemd a cada 30 minutos)
SYNC_INTERVAL_MINUTES=30
SYNC_LOCK_TTL_MINUTES=20
STALE_AFTER_MINUTES=90

# Página Atenção: n.º de cartões em curso por pessoa acima do qual o WIP é sinalizado
ATTENTION_WIP_PER_PERSON=3

# Worker de jobs (fila na coleção `jobs` do MongoDB)
WORKER_POLL_SECONDS=2
JOB_TIMEOUT_MINUTES=30
JOB_RETENTION_DAYS=7

# Exportações
EXPORT_DIR=/var/lib/boardinsight/exports
EXPORT_RETENTION_DAYS=30
EXPORT_MAX_ROWS=50000
# PDF é gerado no worker; limite menor para o PC antigo.
EXPORT_PDF_MAX_ROWS=2000

# Retenção (dias)
RETENTION_HISTORY_DAYS=183
RETENTION_RAW_DAYS=30
RETENTION_SYNC_RUNS_DAYS=90

# Rate limit local por IP (pedidos por minuto; 0 = desligado): sync manual e exportações
# (CSV/JSON e pedidos de PDF/XLSX). Excedido → 429 rate_limited com Retry-After.
RATE_LIMIT_SYNC_PER_MINUTE=2
RATE_LIMIT_EXPORT_PER_MINUTE=6
